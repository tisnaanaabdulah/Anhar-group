{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'owner')",
        ".write": "auth != null && auth.uid === $uid && (!data.exists() && newData.child('role').val() === 'buyer' || data.exists() && data.child('role').val() === newData.child('role').val())"
      }
    },
    "orders": {
      "$orderId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'",
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid"
      }
    }
  }
}